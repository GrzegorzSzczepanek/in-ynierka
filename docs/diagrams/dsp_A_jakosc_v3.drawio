<mxfile host="app.diagrams.net"><diagram id="d" name="Potok DSP, część A: pozyskanie sygnału i kontrola jakości"><mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="940" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0_0" value="&lt;b&gt;Potok DSP, część A: pozyskanie sygnału i kontrola jakości&lt;/b&gt;&lt;br&gt;Od próbek z czepka do decyzji, czy okno jest ważne. Parametry początkowe do potwierdzenia na danych pilotażowych." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="50" as="geometry"/></mxCell><mxCell id="s0" value="Czepek EEG&lt;br&gt;Próbki EEG w µV, częstotliwość i kanały z konfiguracji urządzenia (np. 250 Hz, O1 i O2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="380" height="85" as="geometry"/></mxCell><mxCell id="s1" value="Bufor i znaczniki czasu&lt;br&gt;Wykrycie luki w ciągłości (utrata pakietów, przerwa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="380" height="75" as="geometry"/></mxCell><mxCell id="q1" value="Kontrola jakości surowych próbek (osobno dla każdego kanału)&lt;br&gt;Nasycenie, sygnał płaski&lt;br&gt;Po luce i po starcie sesji: reset stanu filtra, okna nieważne do ustabilizowania" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="310" width="380" height="115" as="geometry"/></mxCell><mxCell id="s2" value="Filtr pasmowy 1 do 40 Hz&lt;br&gt;(Butterworth rzędu 4, przyczynowy)&lt;br&gt;Filtr notch 50 Hz (domyślnie włączony)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="460" width="380" height="95" as="geometry"/></mxCell><mxCell id="s3" value="Okno 2 s, krok 64 próbki (256 ms)&lt;br&gt;(długość okna do potwierdzenia, rozważane także 1 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="380" height="85" as="geometry"/></mxCell><mxCell id="q2" value="Kontrola jakości okna (osobno dla każdego kanału)&lt;br&gt;Amplituda (próg w µV jako parametr), skoki, udział mocy 30 do 40 Hz (artefakt mięśniowy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="710" width="380" height="100" as="geometry"/></mxCell><mxCell id="d" value="Okno ważne?&lt;br&gt;(oba kanały przechodzą wszystkie kontrole)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="300" height="100" as="geometry"/></mxCell><mxCell id="ok" value="Okno ważne&lt;br&gt;dalej: diagram B" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="985" width="200" height="70" as="geometry"/></mxCell><mxCell id="inv" value="Okno nieważne&lt;br&gt;Przyczyna do invalid_reasons. Dalej: diagram B (neutralny wynik, przerwanie utrzymania celu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="845" width="360" height="100" as="geometry"/></mxCell><mxCell id="log" value="Zapis: surowe EEG do pliku zawsze, odrzucone okna i ich przyczyny do bazy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="1015" width="360" height="80" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q2" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="tak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a8" value="nie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a9" value="odrzucone okna" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inv" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a10" value="surowe EEG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s1" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="237"/><mxPoint x="900" y="1055"/></Array></mxGeometry></mxCell><mxCell id="t0_1085" value="Źródło filtrów i odrzucania po amplitudzie: Hu i Zhang (red.), EEG Signal Processing and Feature Extraction, Springer, rozdz. 5, tab. 5.2. Pominięte jako nieadekwatne online: epoki wokół bodźców, korekcja linii bazowej, ICA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="0" y="1085" width="380" height="90" as="geometry"/></mxCell><mxCell id="t470_1135" value="&lt;b&gt;Legenda.&lt;/b&gt; Linia ciągła: dane i sterowanie w sesji. Owal: połączenie z drugim diagramem. Ten sam potok (A i B do cechy x) służy kalibracji i sesji treningowej." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1135" width="360" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>