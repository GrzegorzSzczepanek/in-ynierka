<mxfile host="app.diagrams.net"><diagram id="d" name="Potok DSP, część B: cecha, normalizacja i feedback"><mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1170" pageHeight="1500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0_0" value="&lt;b&gt;Potok DSP, część B: cecha, normalizacja i feedback&lt;/b&gt;&lt;br&gt;Od ważnego okna do reakcji neuronka i nagrody. Parametry początkowe do potwierdzenia na danych pilotażowych." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1130" height="50" as="geometry"/></mxCell><mxCell id="okin" value="Okno ważne&lt;br&gt;(z diagramu A)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="340" height="60" as="geometry"/></mxCell><mxCell id="invin" value="Okno nieważne&lt;br&gt;(z diagramu A)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="220" height="60" as="geometry"/></mxCell><mxCell id="w" value="Estymacja widma (Welch)&lt;br&gt;Okno Hanna, segmenty 1 s z nakładaniem 50% (rozdzielczość 1 Hz)&lt;br&gt;Moc alfa 8 do 12 Hz, osobno dla każdego kanału" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="175" width="340" height="105" as="geometry"/></mxCell><mxCell id="f" value="Cecha x = średnia po kanałach z ln((Pα + ε) / P0)&lt;br&gt;P0 = 1 µV² (stała jednostkowa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="320" width="340" height="80" as="geometry"/></mxCell><mxCell id="z" value="Normalizacja odporna&lt;br&gt;z = (x − mediana) / max(1,4826 · MAD, s_min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="340" height="80" as="geometry"/></mxCell><mxCell id="map" value="Mapowanie na poziom reakcji&lt;br&gt;u = clip((z − a) / (b − a), 0, 1)&lt;br&gt;a = −2, b = 2 (z = 0 daje poziom 0,5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="340" height="100" as="geometry"/></mxCell><mxCell id="sm" value="Wygładzanie wykładnicze&lt;br&gt;y = λ u + (1 − λ) y_poprzednie&lt;br&gt;Stan początkowy: wartość neutralna" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="340" height="95" as="geometry"/></mxCell><mxCell id="rew" value="Warunek nagrody: y powyżej progu sesji przez T (około 1 do 2 s)&lt;br&gt;Po nagrodzie histereza: y musi spaść poniżej progu&lt;br&gt;Nagroda: animacja i zdarzenie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="835" width="340" height="105" as="geometry"/></mxCell><mxCell id="log" value="Zapis: zdarzenia nagród i statystyki do bazy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="990" width="340" height="65" as="geometry"/></mxCell><mxCell id="bright" value="Reakcja neuronka (mimika, ruch, rozmiar)&lt;br&gt;Stała luminancja klatki" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="800" y="985" width="300" height="80" as="geometry"/></mxCell><mxCell id="cal" value="Kalibracja: ten sam potok, oczy otwarte, 60 s&lt;br&gt;Pomijamy pierwsze 5 s. Warunek: co najmniej 90% okien ważnych, inaczej powtórka&lt;br&gt;Przebieg 1: mediana i MAD z x&lt;br&gt;Przebieg 2: rozkład y z tymi parametrami, próg sesji = percentyl 60." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;dashed=1;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="320" height="185" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="okin" target="w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f" target="z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="z" target="map"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="y vs próg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm" target="rew"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm" target="bright"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="747"/><mxPoint x="950" y="747"/></Array></mxGeometry></mxCell><mxCell id="a8" value="y := neutralne" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="invin" target="sm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="174" y="747"/></Array></mxGeometry></mxCell><mxCell id="a9" value="przerwij utrzymanie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="invin" target="rew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="86" y="887"/></Array></mxGeometry></mxCell><mxCell id="a10" value="x z okien ważnych" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.15;dashed=1;" edge="1" parent="1" source="f" target="cal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a11" value="mediana, MAD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.85;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="cal" target="z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a12" value="próg sesji" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="cal" target="rew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="848" y="887"/></Array></mxGeometry></mxCell><mxCell id="a13" value="zdarzenia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rew" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t20_1085" value="&lt;b&gt;Legenda.&lt;/b&gt; Linia ciągła: dane i sterowanie w sesji. Linia przerywana: dane do kalibracji i jej wyniki. Szare pole: kalibracja. Owal: połączenie z diagramem A." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1085" width="480" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>