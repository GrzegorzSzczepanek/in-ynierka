<mxfile host="app.diagrams.net"><diagram id="dsp" name="Potok DSP"><mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1705"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t80_10" value="&lt;b&gt;Potok przetwarzania sygnału EEG w czasie rzeczywistym&lt;/b&gt;&lt;br&gt;Od próbek z czepka do jasności neuronka i nagrody. Parametry są wartościami początkowymi do potwierdzenia na danych pilotażowych." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="10" width="900" height="50" as="geometry"/></mxCell><mxCell id="s0" value="Czepek EEG&lt;br&gt;Próbki EEG w µV, 250 Hz, kanały O1 i O2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="90" width="300" height="75" as="geometry"/></mxCell><mxCell id="s1" value="Bufor i znaczniki czasu&lt;br&gt;Kontrola ciągłości (utrata pakietów, przerwa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="195" width="300" height="75" as="geometry"/></mxCell><mxCell id="q1" value="Kontrola jakości surowych próbek&lt;br&gt;Luki, nasycenie, sygnał płaski" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="300" width="300" height="75" as="geometry"/></mxCell><mxCell id="s2" value="Filtr pasmowy 1 do 40 Hz (Butterworth rzędu 4, przyczynowy)&lt;br&gt;Filtr notch 50 Hz (domyślnie włączony)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="405" width="300" height="75" as="geometry"/></mxCell><mxCell id="s3" value="Okno 2 s, krok 64 próbki (256 ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="510" width="300" height="75" as="geometry"/></mxCell><mxCell id="q2" value="Kontrola jakości okna&lt;br&gt;Amplituda (próg w µV jako parametr), skoki" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="615" width="300" height="75" as="geometry"/></mxCell><mxCell id="d" value="Okno ważne?&lt;br&gt;(obie kontrole)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="720" width="200" height="80" as="geometry"/></mxCell><mxCell id="inv" value="Okno nieważne&lt;br&gt;Przyczyna do invalid_reasons, brak nagrody, przerwanie utrzymania celu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="580" y="715" width="300" height="90" as="geometry"/></mxCell><mxCell id="w" value="Estymacja widma (Welch)&lt;br&gt;Okno Hanna, segmenty 1 s z nakładaniem 50% (rozdzielczość 1 Hz)&lt;br&gt;Moc alfa 8 do 12 Hz, osobno dla każdego kanału" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="835" width="300" height="95" as="geometry"/></mxCell><mxCell id="f" value="Cecha x = średnia po kanałach z ln((Pα + ε) / P0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="965" width="300" height="70" as="geometry"/></mxCell><mxCell id="z" value="Normalizacja odporna: z = (x − mediana) / max(1,4826 · MAD, s_min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1070" width="300" height="75" as="geometry"/></mxCell><mxCell id="map" value="Mapowanie: u = clip((z − a) / (b − a), 0, 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1180" width="300" height="70" as="geometry"/></mxCell><mxCell id="sm" value="Wygładzanie wykładnicze: y = λ u + (1 − λ) y_poprzednie&lt;br&gt;Przy nieważnym oknie y wraca do wartości neutralnej" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="200" y="1285" width="300" height="85" as="geometry"/></mxCell><mxCell id="bright" value="Jasność neuronka (ciągły feedback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="30" y="1405" width="240" height="60" as="geometry"/></mxCell><mxCell id="rew" value="Warunek nagrody: y powyżej progu bloku przez 1 do 2 s&lt;br&gt;Nagroda: animacja i zdarzenie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="310" y="1405" width="340" height="80" as="geometry"/></mxCell><mxCell id="log" value="Zapis: surowe EEG do pliku zawsze, zdarzenia, odrzucone okna i statystyki do bazy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="1515" width="300" height="80" as="geometry"/></mxCell><mxCell id="cal" value="Kalibracja: ten sam potok, oczy otwarte, 60 s&lt;br&gt;Pomijamy pierwsze 5 s. Warunek: co najmniej 90% okien ważnych, inaczej powtórka&lt;br&gt;Przebieg 1: mediana i MAD z x. Przebieg 2: rozkład y z tymi parametrami, z niego percentyl progu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;dashed=1;fontSize=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="900" y="1050" width="300" height="125" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q2" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f" target="z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="z" target="map"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a11" value="tak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a12" value="nie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="sm" target="bright"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a14" value="y vs próg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.3;entryY=0;" edge="1" parent="1" source="sm" target="rew"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a15" value="y := neutralne" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="inv" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a16" value="przerwij utrzymanie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="inv" target="rew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="1385"/><mxPoint x="582" y="1385"/></Array></mxGeometry></mxCell><mxCell id="a17" value="mediana, MAD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="cal" target="z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a18" value="próg bloku" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="cal" target="rew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="1445"/></Array></mxGeometry></mxCell><mxCell id="a19" value="zdarzenia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="rew" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="1555"/></Array></mxGeometry></mxCell><mxCell id="a20" value="surowe EEG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s1" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="232"/><mxPoint x="1260" y="1555"/></Array></mxGeometry></mxCell><mxCell id="a21" value="odrzucone okna" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="inv" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1220" y="760"/><mxPoint x="1220" y="1571"/></Array></mxGeometry></mxCell><mxCell id="t30_1515" value="Źródło filtrów i odrzucania po amplitudzie: Hu i Zhang (red.), EEG Signal Processing and Feature Extraction, Springer, rozdz. 5, tab. 5.2. Pominięte jako nieadekwatne online: epoki wokół bodźców, korekcja linii bazowej, ICA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="1515" width="300" height="90" as="geometry"/></mxCell><mxCell id="t900_1615" value="&lt;b&gt;Legenda.&lt;/b&gt; Linia ciągła: dane i sterowanie w sesji. Linia przerywana: parametry z kalibracji. Szare pole: kalibracja." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="1615" width="300" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>