<mxfile host="app.diagrams.net"><diagram id="d" name="Potok DSP, część A: pozyskanie sygnału i kontrola jakości"><mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="860" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0_0" value="&lt;b&gt;Potok DSP, część A: pozyskanie sygnału i kontrola jakości&lt;/b&gt;&lt;br&gt;Od próbek z czepka do decyzji, czy okno jest ważne. Parametry początkowe do potwierdzenia na danych pilotażowych." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="820" height="50" as="geometry"/></mxCell><mxCell id="s0" value="Czepek EEG&lt;br&gt;Próbki EEG w µV, 250 Hz, kanały O1 i O2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="340" height="70" as="geometry"/></mxCell><mxCell id="s1" value="Bufor i znaczniki czasu&lt;br&gt;Kontrola ciągłości (utrata pakietów, przerwa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="185" width="340" height="70" as="geometry"/></mxCell><mxCell id="q1" value="Kontrola jakości surowych próbek&lt;br&gt;Luki, nasycenie, sygnał płaski&lt;br&gt;Po luce: reset stanu filtra i unieważnienie okien do ustabilizowania" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="290" width="340" height="95" as="geometry"/></mxCell><mxCell id="s2" value="Filtr pasmowy 1 do 40 Hz&lt;br&gt;(Butterworth rzędu 4, przyczynowy)&lt;br&gt;Filtr notch 50 Hz (domyślnie włączony)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="420" width="340" height="85" as="geometry"/></mxCell><mxCell id="s3" value="Okno 2 s, krok 64 próbki (256 ms)&lt;br&gt;(długość okna do potwierdzenia, rozważane także 1 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="540" width="340" height="80" as="geometry"/></mxCell><mxCell id="q2" value="Kontrola jakości okna&lt;br&gt;Amplituda (próg w µV jako parametr), skoki" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="655" width="340" height="70" as="geometry"/></mxCell><mxCell id="d" value="Okno ważne?&lt;br&gt;(obie kontrole)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="760" width="200" height="80" as="geometry"/></mxCell><mxCell id="ok" value="Okno ważne&lt;br&gt;dalej: diagram B" style="shape=terminator;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="880" width="200" height="55" as="geometry"/></mxCell><mxCell id="inv" value="Okno nieważne&lt;br&gt;Przyczyna do invalid_reasons. Dalej: diagram B (neutralny wynik, przerwanie utrzymania celu)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="750" width="340" height="100" as="geometry"/></mxCell><mxCell id="log" value="Zapis: surowe EEG do pliku zawsze, odrzucone okna i ich przyczyny do bazy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="920" width="340" height="80" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s1" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s3" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="q2" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="tak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a8" value="nie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="inv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a9" value="odrzucone okna" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="inv" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a10" value="surowe EEG" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s1" target="log"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="220"/><mxPoint x="820" y="960"/></Array></mxGeometry></mxCell><mxCell id="t0_970" value="Źródło filtrów i odrzucania po amplitudzie: Hu i Zhang (red.), EEG Signal Processing and Feature Extraction, Springer, rozdz. 5, tab. 5.2. Pominięte jako nieadekwatne online: epoki wokół bodźców, korekcja linii bazowej, ICA." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="0" y="970" width="360" height="90" as="geometry"/></mxCell><mxCell id="t420_1030" value="&lt;b&gt;Legenda.&lt;/b&gt; Linia ciągła: dane i sterowanie w sesji. Owal: połączenie z drugim diagramem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1030" width="340" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>