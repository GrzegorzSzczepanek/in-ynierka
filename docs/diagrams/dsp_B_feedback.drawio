<mxfile host="app.diagrams.net"><diagram id="d" name="Potok DSP, część B: cecha, normalizacja i feedback"><mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" page="1" pageWidth="1040" pageHeight="1300"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t0_0" value="&lt;b&gt;Potok DSP, część B: cecha, normalizacja i feedback&lt;/b&gt;&lt;br&gt;Od ważnego okna do jasności neuronka i nagrody. Parametry początkowe do potwierdzenia na danych pilotażowych." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1000" height="50" as="geometry"/></mxCell><mxCell id="okin" value="Okno ważne (z diagramu A)" style="shape=terminator;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="340" height="50" as="geometry"/></mxCell><mxCell id="invin" value="Okno nieważne (z diagramu A)" style="shape=terminator;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="250" height="50" as="geometry"/></mxCell><mxCell id="w" value="Estymacja widma (Welch)&lt;br&gt;Okno Hanna, segmenty 1 s z nakładaniem 50% (rozdzielczość 1 Hz)&lt;br&gt;Moc alfa 8 do 12 Hz, osobno dla każdego kanału" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="165" width="340" height="95" as="geometry"/></mxCell><mxCell id="f" value="Cecha x = średnia po kanałach z ln((Pα + ε) / P0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="295" width="340" height="65" as="geometry"/></mxCell><mxCell id="z" value="Normalizacja odporna&lt;br&gt;z = (x − mediana) / max(1,4826 · MAD, s_min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="395" width="340" height="75" as="geometry"/></mxCell><mxCell id="map" value="Mapowanie: u = clip((z − a) / (b − a), 0, 1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="505" width="340" height="65" as="geometry"/></mxCell><mxCell id="sm" value="Wygładzanie wykładnicze&lt;br&gt;y = λ u + (1 − λ) y_poprzednie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="605" width="340" height="75" as="geometry"/></mxCell><mxCell id="rew" value="Warunek nagrody: y powyżej progu bloku przez 1 do 2 s&lt;br&gt;Nagroda: animacja i zdarzenie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="715" width="340" height="75" as="geometry"/></mxCell><mxCell id="log" value="Zapis: zdarzenia nagród i statystyki do bazy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="845" width="340" height="60" as="geometry"/></mxCell><mxCell id="bright" value="Jasność neuronka&lt;br&gt;(ciągły feedback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;arcSize=10;" vertex="1" parent="1"><mxGeometry x="700" y="825" width="240" height="65" as="geometry"/></mxCell><mxCell id="cal" value="Kalibracja: ten sam potok, oczy otwarte, 60 s&lt;br&gt;Pomijamy pierwsze 5 s. Warunek: co najmniej 90% okien ważnych, inaczej powtórka&lt;br&gt;Przebieg 1: mediana i MAD z x&lt;br&gt;Przebieg 2: rozkład y z tymi parametrami, z niego percentyl progu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;dashed=1;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="300" width="300" height="170" as="geometry"/></mxCell><mxCell id="a1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="okin" target="w"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="w" target="f"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f" target="z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="z" target="map"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="map" target="sm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="y vs próg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm" target="rew"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm" target="bright"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="642"/><mxPoint x="820" y="642"/></Array></mxGeometry></mxCell><mxCell id="a8" value="y := neutralne" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="invin" target="sm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="125" y="642"/></Array></mxGeometry></mxCell><mxCell id="a9" value="przerwij utrzymanie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="invin" target="rew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="752"/></Array></mxGeometry></mxCell><mxCell id="a10" value="x z okien ważnych" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.2;dashed=1;" edge="1" parent="1" source="f" target="cal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a11" value="mediana, MAD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="cal" target="z"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a12" value="próg bloku" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="cal" target="rew"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="752"/></Array></mxGeometry></mxCell><mxCell id="a13" value="zdarzenia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rew" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t0_915" value="&lt;b&gt;Legenda.&lt;/b&gt; Linia ciągła: dane i sterowanie w sesji. Linia przerywana: dane do kalibracji i jej wyniki. Szare pole: kalibracja. Owal: połączenie z diagramem A." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="915" width="400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>